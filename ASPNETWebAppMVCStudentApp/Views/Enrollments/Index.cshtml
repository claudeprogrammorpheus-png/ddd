@model IEnumerable<ASPNETWebAppMVCStudentApp.Models.Enrollment>
@{
    ViewBag.Title = "Enrollments";
}

<h2>Enrollments</h2>
<p>@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped">
    <tr>
        <th>@Html.DisplayNameFor(model => model.EnrollmentID)</th>
        <th>@Html.DisplayNameFor(model => model.Course)</th>
        <th>@Html.DisplayNameFor(model => model.Student)</th>
        <th>@Html.DisplayNameFor(model => model.Grade)</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.EnrollmentID)</td>
            <td>@Html.DisplayFor(modelItem => item.Course.Title)</td>
            <td>@(item.Student.FirstName + " " + item.Student.LastName)</td>
            <td>@Html.DisplayFor(modelItem => item.Grade)</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.EnrollmentID }) |
                @Html.ActionLink("Details", "Details", new { id = item.EnrollmentID }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.EnrollmentID })
            </td>
        </tr>
    }
</table>
