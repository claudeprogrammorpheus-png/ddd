@model ASPNETWebAppMVCStudentApp.Models.Enrollment
@{
    ViewBag.Title = "Delete Enrollment";
}

<h2>Delete Enrollment</h2>

<h3>Are you sure you want to delete this enrollment?</h3>
<div>
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.Course)</dt>
        <dd>@Model.Course.Title</dd>

        <dt>@Html.DisplayNameFor(model => model.Student)</dt>
        <dd>@(Model.Student.FirstName + " " + Model.Student.LastName)</dd>

        <dt>@Html.DisplayNameFor(model => model.Grade)</dt>
        <dd>@Html.DisplayFor(model => model.Grade)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-danger" />
            @Html.ActionLink("Back to List", "Index")
        </div>
    }
</div>
