@model ASPNETWebAppMVCStudentApp.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
}

<div class="row">
    <div class="col-md-4 col-md-offset-4">
        <h2>Reset Password</h2>
        <p>Enter your username and registered email, then choose a new password.</p>

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.Username, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.NewPassword, new { @class = "control-label" })
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
            </div>

            <input type="submit" value="Reset Password" class="btn btn-primary" />
        }

        <p class="top-buffer">@Html.ActionLink("Back to Login", "Login", "Account")</p>
    </div>
</div>
