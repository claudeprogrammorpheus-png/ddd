@model ASPNETWebAppMVCStudentApp.Models.Course
@{
    ViewBag.Title = "Course Details";
}

<h2>Course Details</h2>

<div>
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.CourseID)</dt>
        <dd>@Html.DisplayFor(model => model.CourseID)</dd>

        <dt>@Html.DisplayNameFor(model => model.Title)</dt>
        <dd>@Html.DisplayFor(model => model.Title)</dd>

        <dt>@Html.DisplayNameFor(model => model.Credits)</dt>
        <dd>@Html.DisplayFor(model => model.Credits)</dd>

        <dt>@Html.DisplayNameFor(model => model.Department)</dt>
        <dd>@(Model.Department == null ? "" : Model.Department.Name)</dd>
    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.CourseID }) |
    @Html.ActionLink("Back to List", "Index")
</p>
