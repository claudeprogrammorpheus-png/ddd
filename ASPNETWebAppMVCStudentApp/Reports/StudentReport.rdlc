<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <!-- Báo cáo danh sách sinh viên theo khóa học (Exercise 4).
       Dữ liệu được truyền từ ReportController qua DataSource "StudentDataSet". -->
  <DataSources>
    <DataSource Name="SchoolDB">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="StudentDataSet">
      <Query>
        <DataSourceName>SchoolDB</DataSourceName>
        <CommandText />
      </Query>
      <Fields>
        <Field Name="StudentID">
          <DataField>StudentID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FirstName">
          <DataField>FirstName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastName">
          <DataField>LastName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Grade">
          <DataField>Grade</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportParameters>
    <ReportParameter Name="CourseTitle">
      <DataType>String</DataType>
      <Prompt>Course Title</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
  </ReportParameters>

  <Body>
    <ReportItems>
      <Textbox Name="ReportTitle">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Student List for Selected Course</Value>
                <Style>
                  <FontSize>16pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0cm</Top>
        <Left>0cm</Left>
        <Height>1cm</Height>
        <Width>16cm</Width>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>

      <Textbox Name="CourseInfo">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Course: " &amp; Parameters!CourseTitle.Value</Value>
                <Style>
                  <FontSize>11pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>1.2cm</Top>
        <Left>0cm</Left>
        <Height>0.8cm</Height>
        <Width>16cm</Width>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>

      <Table Name="StudentTable">
        <DataSetName>StudentDataSet</DataSetName>
        <Top>2.2cm</Top>
        <Left>0cm</Left>
        <Height>1.4cm</Height>
        <Width>16cm</Width>
        <TableColumns>
          <TableColumn>
            <Width>3cm</Width>
          </TableColumn>
          <TableColumn>
            <Width>4.5cm</Width>
          </TableColumn>
          <TableColumn>
            <Width>4.5cm</Width>
          </TableColumn>
          <TableColumn>
            <Width>4cm</Width>
          </TableColumn>
        </TableColumns>
        <Header>
          <RepeatOnNewPage>true</RepeatOnNewPage>
          <TableRows>
            <TableRow>
              <Height>0.7cm</Height>
              <TableCells>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="HeaderStudentID">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Student ID</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>LightGrey</BackgroundColor>
                        <Border><Style>Solid</Style></Border>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingTop>4pt</PaddingTop>
                      </Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="HeaderFirstName">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>First Name</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>LightGrey</BackgroundColor>
                        <Border><Style>Solid</Style></Border>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingTop>4pt</PaddingTop>
                      </Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="HeaderLastName">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Last Name</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>LightGrey</BackgroundColor>
                        <Border><Style>Solid</Style></Border>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingTop>4pt</PaddingTop>
                      </Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="HeaderGrade">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Grade</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>LightGrey</BackgroundColor>
                        <Border><Style>Solid</Style></Border>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingTop>4pt</PaddingTop>
                      </Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Header>
        <TableGroups>
          <TableGroup>
            <Group Name="Details" />
            <TableRows>
              <TableRow>
                <Height>0.6cm</Height>
                <TableCells>
                  <TableCell>
                    <ReportItems>
                      <Textbox Name="StudentID">
                        <CanGrow>true</CanGrow>
                        <KeepTogether>true</KeepTogether>
                        <Paragraphs>
                          <Paragraph>
                            <TextRuns>
                              <TextRun>
                                <Value>=Fields!StudentID.Value</Value>
                                <Style />
                              </TextRun>
                            </TextRuns>
                            <Style />
                          </Paragraph>
                        </Paragraphs>
                        <Style>
                          <Border><Style>Solid</Style></Border>
                          <PaddingLeft>4pt</PaddingLeft>
                          <PaddingTop>4pt</PaddingTop>
                        </Style>
                      </Textbox>
                    </ReportItems>
                  </TableCell>
                  <TableCell>
                    <ReportItems>
                      <Textbox Name="FirstName">
                        <CanGrow>true</CanGrow>
                        <KeepTogether>true</KeepTogether>
                        <Paragraphs>
                          <Paragraph>
                            <TextRuns>
                              <TextRun>
                                <Value>=Fields!FirstName.Value</Value>
                                <Style />
                              </TextRun>
                            </TextRuns>
                            <Style />
                          </Paragraph>
                        </Paragraphs>
                        <Style>
                          <Border><Style>Solid</Style></Border>
                          <PaddingLeft>4pt</PaddingLeft>
                          <PaddingTop>4pt</PaddingTop>
                        </Style>
                      </Textbox>
                    </ReportItems>
                  </TableCell>
                  <TableCell>
                    <ReportItems>
                      <Textbox Name="LastName">
                        <CanGrow>true</CanGrow>
                        <KeepTogether>true</KeepTogether>
                        <Paragraphs>
                          <Paragraph>
                            <TextRuns>
                              <TextRun>
                                <Value>=Fields!LastName.Value</Value>
                                <Style />
                              </TextRun>
                            </TextRuns>
                            <Style />
                          </Paragraph>
                        </Paragraphs>
                        <Style>
                          <Border><Style>Solid</Style></Border>
                          <PaddingLeft>4pt</PaddingLeft>
                          <PaddingTop>4pt</PaddingTop>
                        </Style>
                      </Textbox>
                    </ReportItems>
                  </TableCell>
                  <TableCell>
                    <ReportItems>
                      <Textbox Name="Grade">
                        <CanGrow>true</CanGrow>
                        <KeepTogether>true</KeepTogether>
                        <Paragraphs>
                          <Paragraph>
                            <TextRuns>
                              <TextRun>
                                <Value>=Format(Fields!Grade.Value, "0.00")</Value>
                                <Style />
                              </TextRun>
                            </TextRuns>
                            <Style />
                          </Paragraph>
                        </Paragraphs>
                        <Style>
                          <Border><Style>Solid</Style></Border>
                          <PaddingLeft>4pt</PaddingLeft>
                          <PaddingTop>4pt</PaddingTop>
                        </Style>
                      </Textbox>
                    </ReportItems>
                  </TableCell>
                </TableCells>
              </TableRow>
            </TableRows>
          </TableGroup>
        </TableGroups>
      </Table>
    </ReportItems>
    <Height>5cm</Height>
    <Style />
  </Body>

  <PageFooter>
    <Height>1cm</Height>
    <PrintOnFirstPage>true</PrintOnFirstPage>
    <PrintOnLastPage>true</PrintOnLastPage>
    <ReportItems>
      <Textbox Name="PageNumber">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                <Style>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Right</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.2cm</Top>
        <Left>12cm</Left>
        <Height>0.6cm</Height>
        <Width>4cm</Width>
        <Style>
          <Border><Style>None</Style></Border>
        </Style>
      </Textbox>
    </ReportItems>
    <Style />
  </PageFooter>

  <Width>16cm</Width>
  <Page>
    <PageHeight>29.7cm</PageHeight>
    <PageWidth>21cm</PageWidth>
    <LeftMargin>2.5cm</LeftMargin>
    <RightMargin>2.5cm</RightMargin>
    <TopMargin>2cm</TopMargin>
    <BottomMargin>2cm</BottomMargin>
    <Style />
  </Page>
  <Language>en-US</Language>
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
  <rd:ReportID>StudentReport</rd:ReportID>
</Report>
