<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.config for ASPNETWebAppMVCStudentApp (.NET Framework 4.8, ASP.NET MVC 5).
  Khi tạo project bằng Visual Studio, file này đã có sẵn; chỉ cần thêm phần <connectionStrings>
  và <appSettings> bên dưới (không ghi đè các section khác do Visual Studio sinh ra).
-->
<configuration>
  <connectionStrings>
    <!-- Đổi data source thành tên SQL Server của bạn (ví dụ: localhost, .\SQLEXPRESS, DESKTOP-XXXX\SQLEXPRESS) -->
    <add name="SchoolDBEntities"
         connectionString="data source=.;initial catalog=SchoolDB;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- Bật Session để lưu thông tin đăng nhập (Exercise 3) -->
    <sessionState timeout="30" />
  </system.web>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
